# path to p12
P12_PATH=

# Secrets & config để build / phát hành BerryShot (chỉ dùng local, maintainer).
# Copy thành .env (cùng thư mục) rồi điền — .env và cả thư mục deploy/ đã gitignore,
# KHÔNG BAO GIỜ commit giá trị thật.

# ============ Ký + notarize (Apple) — dùng bởi deploy/release.sh ============

# Email đăng nhập tài khoản Apple Developer (tài khoản chứa cert "Developer ID
# Application: Vu Dong").
APPLE_ID=

# App-specific password — KHÔNG phải mật khẩu Apple ID thường.
# Tạo tại: appleid.apple.com → Sign-In and Security → App-Specific Passwords
# (phải tạo từ đúng Apple ID ở trên). Dạng: xxxx-xxxx-xxxx-xxxx
APP_SPEC_PASSWORD=

# (tuỳ chọn) Script đã mặc định 2 giá trị dưới, chỉ điền khi đổi tài khoản dev.
# SIGNING_IDENTITY=Developer ID Application: Vu Dong (WZ2Z528AM6)
# APPLE_TEAM_ID=WZ2Z528AM6

# ============ Cập nhật tự động (Sparkle) — dùng bởi deploy/release.sh ============
# Public EdDSA key (Sparkle) nhúng vào Info.plist để verify update. Tạo cặp khóa
# bằng Sparkle `generate_keys` (private key nằm ở Keychain). BẮT BUỘC cho release.
SU_PUBLIC_ED_KEY=
# (tuỳ chọn) Mặc định trỏ domain R2 bên dưới.
# SU_FEED_URL=https://berryshot-download.notex.work/appcast.xml
# DOWNLOAD_BASE_URL=https://berryshot-download.notex.work
# (tuỳ chọn) Đường dẫn tới Sparkle `sign_update` nếu không nằm trong PATH/.build.
# SPARKLE_BIN=

# ============ Update server R2 — dùng bởi deploy/upload-release.py ============
# CẢ 4 giá trị đều BẮT BUỘC cho bước upload; thiếu bất kỳ giá trị nào -> bỏ qua upload.
# Lấy từ Cloudflare dashboard (dash.cloudflare.com):

# Account ID: mở trang R2 Object Storage — "Account ID" nằm ở cột phải
# (hoặc chính là chuỗi hex trong URL: dash.cloudflare.com/<ACCOUNT_ID>/r2).
R2_ACCOUNT_ID=

# Cặp key S3-compatible: trang R2 → nút "Manage R2 API Tokens" (góc phải)
# → Create API Token → Permissions chọn "Object Read & Write" → Specify
# bucket(s) chọn đúng bucket bên dưới → Create.
# ⚠️ Secret chỉ hiện MỘT LẦN ngay sau khi tạo — copy liền cả 2 giá trị.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Tên bucket đang gắn custom domain berrydb-download.notex.work
# (trang R2 → danh sách bucket — lấy đúng tên, không phải domain).
R2_BUCKET=

# ---- (khuyên dùng) Tự purge cache sau upload — Cloudflare cache 404 tới 4h ----
# CF_ZONE_ID: dash.cloudflare.com → chọn site notex.work → Overview, cột phải
# "Zone ID". CF_API_TOKEN: My Profile → API Tokens → Create Token → template
# "Purge cache" (quyền Zone.Cache Purge, scope zone notex.work).
# CF_ZONE_ID=
# CF_API_TOKEN=
SU_PUBLIC_ED_KEY=