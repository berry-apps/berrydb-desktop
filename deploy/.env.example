# Path to .p12 certificate (optional if already installed in Keychain)
P12_PATH=

# Secrets & configuration for building / releasing BerryDB (maintainers only).
# Copy to .env (in this directory) and fill in values — deploy/.env is gitignored.
# NEVER commit real credentials.

# ============ Code Signing & Notarization (Apple) — used by deploy/release.sh ============

# Apple ID for Apple Developer account:
APPLE_ID=

# App-specific password (NOT regular Apple ID password).
# Generate at: appleid.apple.com -> Sign-In and Security -> App-Specific Passwords
# Format: xxxx-xxxx-xxxx-xxxx
APP_SPEC_PASSWORD=

# Developer ID signing identity and Apple Team ID:
SIGNING_IDENTITY=
APPLE_TEAM_ID=

# ============ Auto-Update (Sparkle) — used by deploy/release.sh ============
# Public EdDSA key (Sparkle) embedded into Info.plist to verify updates.
# Generate key pair using Sparkle's `generate_keys` (private key stays in Keychain).
SU_PUBLIC_ED_KEY=
# (Optional) Defaults to download domain below.
# SU_FEED_URL=https://download-db.berryhub.app/appcast.xml
# DOWNLOAD_BASE_URL=https://download-db.berryhub.app
# (Optional) Path to Sparkle `sign_update` binary if not in PATH or .build.
# SPARKLE_BIN=

# ============ Cloudflare R2 Release Storage — used by deploy/upload-release.py ============
# All 4 values are REQUIRED for the upload step. If any is missing, upload is skipped.
# Retrieve from Cloudflare dashboard (dash.cloudflare.com):

# Cloudflare Account ID (dash.cloudflare.com/<ACCOUNT_ID>/r2):
R2_ACCOUNT_ID=

# S3-compatible credentials: R2 -> Manage R2 API Tokens -> Create API Token
# Permissions: "Object Read & Write", specify the release bucket below.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 Bucket name attached to custom domain download-db.berryhub.app:
R2_BUCKET=

# ---- (Optional) Automatic Cloudflare CDN Cache Purge after upload ----
# CF_ZONE_ID: dash.cloudflare.com -> select domain -> Overview, right sidebar "Zone ID"
# CF_API_TOKEN: My Profile -> API Tokens -> Create Token -> template "Purge cache"
# CF_ZONE_ID=
# CF_API_TOKEN=