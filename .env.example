# Local dev overrides for `make run`/`make watch` (scripts/run.sh,
# scripts/dev-watch.sh). Copy to .env and edit — .env is gitignored, never
# committed (see .gitignore: `*.env*` / `!.env.example`).

# Backend API the app talks to for license activation + AI (BerryUI/Sources/
# LicenseSupport.swift). Defaults to http://127.0.0.1:8787 (local dev
# berrydb-api) when unset. Point at the deployed API instead:
# BERRYDB_BACKEND_URL=https://berrydb-api.berryhub.app

# Must match the target backend's signing key or activation fails with
# LicenseVerifyError.badSignature (error 2) — the local backend's own
# BERRYDB_LICENSE_SEED fallback matches the app's built-in dev key, so this
# is only needed alongside BERRYDB_BACKEND_URL above. Not a secret — fetch
# the current value straight from the backend:
#   curl https://berrydb-api.berryhub.app/v1/license-public-key
# BERRYDB_LICENSE_PUBLIC_KEY=OaNjGroRKfxdNsKZI2O4jgqRXJjvj5VToySZL8oJmO0=
